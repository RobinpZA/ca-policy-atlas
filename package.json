{
  "name": "ca-policy-atlas",
  "version": "0.3.0",
  "private": true,
  "description": "Visualize and compare Microsoft Entra Conditional Access baseline policies as side-by-side flow graphs.",
  "author": "Robin Pieterse · Turrito Networks",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify && tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify-baselines.mjs",
    "sync-baselines": "node scripts/sync-baselines.mjs",
    "sync-app-ids": "node scripts/sync-app-ids.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run verify && tsc --noEmit && eslint . && vitest run"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
